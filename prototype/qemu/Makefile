# Builds and runs one translated procedure under QEMU. `program.cpp` is
# regenerated by test/qemu-run.ts before every invocation (a `static const
# uint16_t code[]` blob plus a `main()` that jumps into it and reports the
# result via semihosting_exit) — this Makefile itself never changes between
# runs, only program.cpp's contents do.

OUTPUT = run.elf

SOURCES += ../../src/vectors.S
SOURCES += semihosting.cpp
SOURCES += program.cpp
SOURCES += runtime.S
SOURCES += runtime_host.cpp
SOURCES += compile_proc.cpp

INCLUDE_DIRS += ../../src

# C++ throughout (only runtime.S/../../src/vectors.S stay assembly) — g++
# as both compiler and link driver, everywhere gcc used to be. No
# exceptions/RTTI: nothing here throws, catches, or does a polymorphic
# dynamic_cast/typeid, and both pull in extra flash-resident tables and
# unwind machinery a bare-metal, -nostartfiles target has no runtime
# support for anyway.
CC  = arm-none-eabi-g++
LD  = arm-none-eabi-g++
OBJCOPY = arm-none-eabi-objcopy

CFLAGS += -mcpu=cortex-m0 -mthumb -Os
CFLAGS += -std=gnu++17 -fno-exceptions -fno-rtti
CFLAGS += $(addprefix -I,$(INCLUDE_DIRS))
ASMFLAGS += -mcpu=cortex-m0

LDFLAGS += -mcpu=cortex-m0 -mthumb
LDFLAGS += -static -nostartfiles
LDFLAGS += -specs=nosys.specs
LDFLAGS += -T ../../src/linker.ld

OBJECTS = $(addsuffix .o,$(notdir $(SOURCES)))

%.S.o: ../../src/%.S
	$(CC) $(ASMFLAGS) -c -o $@ $<

%.S.o: %.S
	$(CC) $(ASMFLAGS) -c -o $@ $<

%.cpp.o: %.cpp
	$(CC) $(CFLAGS) -c -o $@ $<

# r8/r9/r10/r11 carry live JIT state across compileProc's own call boundary
# (docs/design.md §2) — reserved from the compiler's
# allocator entirely, a stronger guarantee than relying on ordinary
# callee-saved convention (see compile_proc.cpp's own header).
#
# -Wstack-usage=48 -Werror=stack-usage=48: enforces the exact frame size
# runtime_host.cpp's own MOCK_TRANSLATOR_ENTRY_WORST_CASE_BYTES bakes in
# for this function (48, measured via -fstack-usage) — grow past it and
# the build fails right here, instead of that stack-usage accounting
# silently going stale. compile_proc.cpp has to be its own translation
# unit for this: applying the same threshold to runtime_host.cpp would
# also apply it to enter_program_on_stack/_split's own VLAs, which
# -Wstack-usage= flags regardless of the threshold since their size
# genuinely isn't known at compile time — a real difference in kind, not
# just in number, from compileProc's own fixed frame. Still one number
# after encapsulating the arena/dispatch-table logic into Runtime's own
# methods (runtime_internal.h) — they're defined inline and fold straight
# back into compileProc at -Os, confirmed via -fstack-usage, not assumed.
compile_proc.cpp.o: compile_proc.cpp
	$(CC) $(CFLAGS) -ffixed-r8 -ffixed-r9 -ffixed-r10 -ffixed-r11 -Wstack-usage=48 -Werror=stack-usage=48 -c -o $@ $<

$(OUTPUT): $(OBJECTS)
	$(LD) $(LDFLAGS) -o $@ $(OBJECTS)

.PHONY: run clean
run: $(OUTPUT)
	qemu-system-arm -M lm3s811evb -m 8k -nographic \
	    -semihosting-config enable=on,target=native -kernel $(OUTPUT)

clean:
	rm -f $(OUTPUT) *.o
